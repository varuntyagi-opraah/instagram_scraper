# Meta Business Discovery (see docs/META_SETUP.md). Leave empty to run logged-out only.
META_ACCESS_TOKEN=
META_IG_USER_ID=
META_GRAPH_VERSION=v27.0
META_HOURLY_CAP=180

# Logged-out public pages
OPRAAH_WEB_FETCHER=instaloader        # or: obscura (post pages only; tools/obscura/obscura)
OPRAAH_WEB_MIN_INTERVAL=2.0           # seconds between requests (jittered up to MAX)
OPRAAH_WEB_MAX_INTERVAL=4.0
OPRAAH_WEB_HOURLY_CAP=300

# Collection window and cadence
OPRAAH_WINDOW_POSTS=30
OPRAAH_WINDOW_DAYS=30
OPRAAH_FULL_EVERY_DAYS=30             # --due: full refresh interval
OPRAAH_LIGHT_EVERY_DAYS=7             # --due: counts + new posts interval

# OPRAAH_DATA_DIR=./data

# YouTube Data API v3 (see docs/YOUTUBE_SETUP.md)
YOUTUBE_API_KEY=
YOUTUBE_DAILY_UNITS=9000              # local cap below Google's 10,000/day default

# Mirror data/kb into a Google Drive for desktop folder after every export (see docs/DRIVE.md)
# OPRAAH_KB_SYNC_DIR=~/Library/CloudStorage/GoogleDrive-you@example.com/My Drive/Opraah/creator_kb
